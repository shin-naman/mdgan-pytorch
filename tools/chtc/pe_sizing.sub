# Sizing run: paper-scale PE (configs/pe_paper.json), 2,000 iterations on one GPU, with two
# 8192-chain evaluations. Measures iterations/second and evaluation cost, so the full
# 300k-iteration jobs can be sized. Submit from the repo root:  condor_submit tools/chtc/pe_sizing.sub
#
# Lines marked VERIFY are CHTC-specific; check them against CHTC's current GPU and
# container guides before the first submission (docs/cluster.md).

universe                = container
# VERIFY tag
container_image         = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

executable              = tools/chtc/run_train.sh
arguments               = sizing 0 --set n_iterations=2000 --set checkpoint_every=1000

should_transfer_files   = YES
transfer_input_files    = src, configs/pe_paper.json, data/cache/PE.npz
when_to_transfer_output = ON_EXIT
transfer_output_files   = run_sizing

request_gpus            = 1
# VERIFY
+WantGPULab             = true
# VERIFY: short / medium / long
+GPUJobLength           = "short"
request_cpus            = 2
request_memory          = 24GB
request_disk            = 10GB

log                     = logs/sizing.log
output                  = logs/sizing.out
error                   = logs/sizing.err

queue 1
