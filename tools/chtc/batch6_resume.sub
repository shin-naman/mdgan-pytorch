# Batch 6, resumes: 3 jobs to 300k, each config differing from the run's original only in n_iterations (so the
# dataset metadata, offset maximum 0 included, must match, and no full checkpoint is added beyond 50k).
#   positions_c8338177_seed0  100k -> 300k  configs/resume_positions_300k.json (= batch4_positions at 300k): the
#                             paper's reading at the authors' budget, for the matched-grid table.
#   m128_c7675778_seed2       100k -> 300k  configs/resume_m128_300k.json (= batch1_m128 = batch2_m128 at 300k)
#   m128_c7810278_seed5       100k -> 300k  same config: the complete modified-method result for the certificates and
#                             the best-of-30 comparison.
# Each job takes its run directory in under its original name (upload them to the VM first); --auto-resume continues
# from latest.pt. Logs get a _resume_c<Cluster> suffix. 200k more iterations: about 3 h (positions), 6 h (m128).
# Submit from the repository root in /home:  condor_submit tools/chtc/batch6_resume.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

# ---- new runs -------------------------------------------------------------------------------------
arguments                 = $(RUN) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=$(CFG).json"
transfer_input_files      = src, configs/$(CFG).json, data/cache/PE.npz, run_$(RUN)
transfer_checkpoint_files = run_$(RUN)
transfer_output_files     = run_$(RUN)
log                       = logs/$(RUN)_resume_c$(Cluster).log
output                    = logs/$(RUN)_resume_c$(Cluster).out
error                     = logs/$(RUN)_resume_c$(Cluster).err

queue CFG, RUN, SEED from (
  resume_positions_300k, positions_c8338177_seed0, 0
  resume_m128_300k, m128_c7675778_seed2, 2
  resume_m128_300k, m128_c7810278_seed5, 5
)
