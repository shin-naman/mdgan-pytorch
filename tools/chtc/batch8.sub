# Batch 8: the rewards with a 2-block critic, and short data. 18 jobs = 6 arms x seeds 0-2, 50k, snapshots every
# 10k and one full checkpoint at 50k. M 64, sigma units, 50 training trajectories with the same ten held out as in
# Batches 6-7 everywhere. Each config is configs/batch7_c8_noise_corr.json with only window_offset_max_steps,
# critic_blocks, noise_use_min and corr_reward_blocks changed. NOT in the papers.
# Rewards: noise = noise_use_min 0.5 (weight 100); corr(1-3) = corr_reward_blocks 4 (weight 10): the block-sum
# correlations of the 1024 side chains at lags 1-3 are pulled to the training region's (dataset.json,
# corr_reward_targets). Measured on the 50 training trajectories:
#     all 80 ns  -0.148 -0.010 -0.018      10.24 ns  -0.160 -0.016 +0.011      5.12 ns  -0.141 +0.007 -0.025
# Lags 1-3 instead of Batch 7's 1-7 because a short region does not pin the far lags down: in the miniature (8 blocks
# of data, 2-block critic, 4 stretches x 2 seeds) lags 1-7 bent the MSD in 3 of 8 runs, lags 1-3 in 0 of 8.
#
#   arm            data region                         critic  rewards            reads against
#   c2_both_full   all 80 ns (offset max 7872)         2       noise + corr(1-3)  offsets_full (same data, no rewards)
#                  PREDICTION: pass on a majority; sum rho -0.15 to -0.20;        and c8_noise_corr (same rewards,
#                  D about 1.0; err in the authors' typical range or below.       8-block critic)
#   c2_noise_full  all 80 ns                           2       noise only         c2_both_full
#                  PREDICTION: latent mixes; sum rho (1-3) -0.05 to -0.10; D 1.3 to 1.5 x.
#   c2_corr_full   all 80 ns                           2       corr(1-3) only     c2_both_full
#                  PREDICTION: sum rho (1-3) pinned; drift returns in some seeds (DC high), since lags 1-3 cannot
#                  see it.
#   c2_both_10ns   16 blocks (region 1024 steps,       2       noise + corr(1-3)  c2_both_full
#                  offset max 896)
#                  PREDICTION: no bends; var/MD about 1; D 1.1 to 1.3 x.
#   c2_both_5ns    8 blocks (region 512 steps,         2       noise + corr(1-3)  c2_both_10ns; Batch 7b
#                  offset max 384)
#                  PREDICTION: no collapse (unlike 7b); var/MD about 1; D 1.3 to 1.5 x.
#   c4_both_10ns   16 blocks                           4       noise + corr(1-3)  c2_both_10ns
#                  PREDICTION: same as c2_both_10ns.
#
# Read block variance, sum rho and the MSD against the reference at fixed times before D; D means nothing where the
# MSD is bent. Extra columns in metrics.jsonl: noise_use_share, noise_use_penalty, corr_error, reward_loss.
# Laptop check only (40 iterations of each config on CPU): all six start, values finite. Time per iteration on CPU:
# the arms with corr(1-3) about 2 x c2_noise_full. No run at this size exists; at 5.12 ns two 600-iteration laptop
# runs (2- and 4-block critic, lags 1-7) trained without the 7b collapse (W 5, step std 0.95).
# Submit from the repository root in /home:  condor_submit tools/chtc/batch8.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

arguments                 = $(ARM)_c$(Cluster)_seed$(SEED) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=batch8_$(ARM).json"
transfer_input_files      = src, configs/batch8_$(ARM).json, data/cache/PE.npz
transfer_checkpoint_files = run_$(ARM)_c$(Cluster)_seed$(SEED)
transfer_output_files     = run_$(ARM)_c$(Cluster)_seed$(SEED)
log                       = logs/$(ARM)_c$(Cluster)_seed$(SEED).log
output                    = logs/$(ARM)_c$(Cluster)_seed$(SEED).out
error                     = logs/$(ARM)_c$(Cluster)_seed$(SEED).err

queue ARM, SEED from (
  c2_both_full, 0
  c2_both_full, 1
  c2_both_full, 2
  c2_noise_full, 0
  c2_noise_full, 1
  c2_noise_full, 2
  c2_corr_full, 0
  c2_corr_full, 1
  c2_corr_full, 2
  c2_both_10ns, 0
  c2_both_10ns, 1
  c2_both_10ns, 2
  c2_both_5ns, 0
  c2_both_5ns, 1
  c2_both_5ns, 2
  c4_both_10ns, 0
  c4_both_10ns, 1
  c4_both_10ns, 2
)
