# The paper's protocol on PE: configs/pe_paper.json (n_s = 1, n_z = 32, M = 64, width 2048,
# 300k iterations, checkpoint + 8192-chain evaluation every 10k), one job per seed (0-4).
# Submit from the repository root in /home, AFTER the sizing run:
#     condor_submit tools/chtc/pe_paper.sub
#
# Job length: set +GPUJobLength from the sizing run (CHTC GPU Lab limits: short 12 h,
# medium 24 h, long 7 days with at most 4 GPUs in use per user), and MAX_HOURS just under
# that limit (short 11, medium 23, long 160). Within its length a GPU Lab job is not evicted,
# so the self-checkpoint below is a safety net: if training is not done by MAX_HOURS, the job
# saves latest.pt, exits 85, HTCondor keeps the run directory in /spool and restarts the job,
# which resumes. +is_resumable is deliberately NOT set: it opts into backfill GPUs that can evict.
# Names carry $(Cluster), so a later submission never overwrites earlier results.

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

executable                = tools/chtc/run_train.sh
arguments                 = c$(Cluster)_seed$(Process) $(Process)
environment               = "MAX_HOURS=11"

should_transfer_files     = YES
transfer_input_files      = src, configs/pe_paper.json, data/cache/PE.npz
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85
transfer_checkpoint_files = run_c$(Cluster)_seed$(Process)
transfer_output_files     = run_c$(Cluster)_seed$(Process)

request_gpus              = 1
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

log                       = logs/pe_c$(Cluster)_seed$(Process).log
output                    = logs/pe_c$(Cluster)_seed$(Process).out
error                     = logs/pe_c$(Cluster)_seed$(Process).err

queue 5
