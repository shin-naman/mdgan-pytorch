# Batch 9, resumes: 6 jobs, Batch 8's c2_both_full and c2_both_5ns, seeds 0-2 (cluster 8855811), 50k -> 100k.
# PURPOSE: do the variance excursions recover or run away. Each config is the Batch 8 config with n_iterations
# 100000 and nothing else changed (resume refuses anything else), so the one full checkpoint stays at 50k and five
# snapshots are added (60k-100k). Checked on the laptop: for each of the six latest.pt files (iteration 50000, a full
# checkpoint), the config run_train.sh builds on resume (checkpoint config <- this JSON <- seed) differs from the
# checkpoint's only in n_iterations. A run trained at 6e41f72 and resumed by the Batch 9 code ends bit-identical to
# one trained throughout at 6e41f72 (laptop, CPU, three Batch 8 configs).
# Code: commit 8f6ebe8 on branch batch8-short-data. NOT in the papers (Batch 8's rewards and offsets).
# Each job takes its run directory in under its original name (the folders must be on the submit node);
# --auto-resume continues from latest.pt. 50k more iterations at about 0.08 s each: 1-3 h, one session.
# Disk: each folder grows from 1.0 GB to about 1.4 GB. Logs get a _resume_c<Cluster> suffix.
# Submit from the repository root in /home:  condor_submit tools/chtc/batch9_resume.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

arguments                 = $(RUN) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=$(CFG).json"
transfer_input_files      = src, configs/$(CFG).json, data/cache/PE.npz, run_$(RUN)
transfer_checkpoint_files = run_$(RUN)
transfer_output_files     = run_$(RUN)
log                       = logs/$(RUN)_resume_c$(Cluster).log
output                    = logs/$(RUN)_resume_c$(Cluster).out
error                     = logs/$(RUN)_resume_c$(Cluster).err

queue CFG, RUN, SEED from (
  resume_c2_both_full_100k, c2_both_full_c8855811_seed0, 0
  resume_c2_both_full_100k, c2_both_full_c8855811_seed1, 1
  resume_c2_both_full_100k, c2_both_full_c8855811_seed2, 2
  resume_c2_both_5ns_100k, c2_both_5ns_c8855811_seed0, 0
  resume_c2_both_5ns_100k, c2_both_5ns_c8855811_seed1, 1
  resume_c2_both_5ns_100k, c2_both_5ns_c8855811_seed2, 2
)
