# Probe: M = 256 (block_len 256), 3 seeds x 50k, sigma units, otherwise configs/pe_paper.json.
# Asks whether m128's effect is the window: if so, Σρ(4-30) shrinks further and the variance deficit
# deepens. The training region becomes the first 5.12 ns of each trajectory (paper: 1.28 ns); 32 blocks
# per 80 ns. (The other half of the question, M = 128 over a 160 ns rollout, needs no training:
# step0_rollouts.py arm-eval --rollout-blocks 125 on the existing m128 checkpoints.)
# Submit from the repository root in /home:  condor_submit tools/chtc/probe_m256.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

executable                = tools/chtc/run_train.sh
arguments                 = $(ARM)_c$(Cluster)_seed$(SEED) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=probe_$(ARM).json"

should_transfer_files     = YES
transfer_input_files      = src, configs/probe_$(ARM).json, data/cache/PE.npz
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85
transfer_checkpoint_files = run_$(ARM)_c$(Cluster)_seed$(SEED)
transfer_output_files     = run_$(ARM)_c$(Cluster)_seed$(SEED)

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

log                       = logs/$(ARM)_c$(Cluster)_seed$(SEED).log
output                    = logs/$(ARM)_c$(Cluster)_seed$(SEED).out
error                     = logs/$(ARM)_c$(Cluster)_seed$(SEED).err

ARM = m256
queue SEED from (
  0
  1
  2
)
