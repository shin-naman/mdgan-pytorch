# Batch 7, resumes: 6 jobs, both arms' three seeds (cluster 8680489), 50k -> 300k. Each config differs from its
# batch-7 config only in n_iterations (resume refuses anything else), so the one full checkpoint stays at 50k.
# Each job takes its run directory in under its original name (the folders are on the VM); --auto-resume continues
# from latest.pt. At 1.8-4 it/s, 250k more iterations take about 17-39 h: several 11 h sessions, each checkpointing
# and restarting. Logs get a _resume_c<Cluster> suffix. NOT in the papers (batch 7's critic and rewards).
# Submit from the repository root in /home:  condor_submit tools/chtc/batch7_resume.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

arguments                 = $(RUN) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=$(CFG).json"
transfer_input_files      = src, configs/$(CFG).json, data/cache/PE.npz, run_$(RUN)
transfer_checkpoint_files = run_$(RUN)
transfer_output_files     = run_$(RUN)
log                       = logs/$(RUN)_resume_c$(Cluster).log
output                    = logs/$(RUN)_resume_c$(Cluster).out
error                     = logs/$(RUN)_resume_c$(Cluster).err

queue CFG, RUN, SEED from (
  resume_c8_noise_300k, c8_noise_c8680489_seed0, 0
  resume_c8_noise_300k, c8_noise_c8680489_seed1, 1
  resume_c8_noise_300k, c8_noise_c8680489_seed2, 2
  resume_c8_noise_corr_300k, c8_noise_corr_c8680489_seed0, 0
  resume_c8_noise_corr_300k, c8_noise_corr_c8680489_seed1, 1
  resume_c8_noise_corr_300k, c8_noise_corr_c8680489_seed2, 2
)
