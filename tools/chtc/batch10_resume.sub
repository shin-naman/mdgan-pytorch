# Batch 10, resumes: 3 jobs, Batch 9's c2_both_paper seeds 0-2 (cluster 8899547), 50k -> 300k.
# PREDICTION: if var/MD is still above 1.3 and err above 40 % at 150k, training length is not the missing piece at
# the paper's budget. (Evaluated at every 10k; read 150k against the Batch 10 arms, and 300k for the trend.)
# resume_c2_both_paper.json is configs/batch9_c2_both_paper.json with n_iterations 300000 and nothing else changed
# (resume refuses anything else), so the one full checkpoint stays at 50k. Checked on the laptop for the three
# latest.pt files (iteration 50000, full checkpoints, trained at a1358ef): the config run_train.sh builds on resume
# (checkpoint config <- this JSON <- seed) differs from the checkpoint's only in n_iterations, field by field.
# The Batch 10 code with the new rewards off trains bit-identically to a1358ef, also when a run started there is
# resumed by it (laptop, CPU, three Batch 8-9 configs including batch9_c2_both_paper).
# Code: commit 0f5ab71 on branch batch8-short-data. NOT in the papers (the rewards).
# Each job takes its run directory in under its original name (the folders must be on the submit node);
# --auto-resume continues from latest.pt. 250k more iterations at about 0.07 s each: 5-17 h, one or two 11 h sessions.
# Disk: each folder grows from 1.1 GB to about 2.9 GB (25 more 72 MB snapshots). Logs get a _resume_c<Cluster> suffix.
# Submit from the repository root in /home:  condor_submit tools/chtc/batch10_resume.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

arguments                 = $(RUN) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=$(CFG).json"
transfer_input_files      = src, configs/$(CFG).json, data/cache/PE.npz, run_$(RUN)
transfer_checkpoint_files = run_$(RUN)
transfer_output_files     = run_$(RUN)
log                       = logs/$(RUN)_resume_c$(Cluster).log
output                    = logs/$(RUN)_resume_c$(Cluster).out
error                     = logs/$(RUN)_resume_c$(Cluster).err

queue CFG, RUN, SEED from (
  resume_c2_both_paper, c2_both_paper_c8899547_seed0, 0
  resume_c2_both_paper, c2_both_paper_c8899547_seed1, 1
  resume_c2_both_paper, c2_both_paper_c8899547_seed2, 2
)
