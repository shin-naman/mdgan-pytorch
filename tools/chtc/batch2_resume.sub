# Batch 2, resumes: 6 jobs. Batch-1 runs m128 and wd01 (cluster 7675778) seeds 0-2, 50k -> 100k. Each job
# takes its run directory in under its original name and --auto-resume continues from latest.pt; the
# configs differ from batch1_<arm>.json only in n_iterations. Logs get a _resume_c<Cluster> suffix so the
# batch-1 logs of those runs are kept. The new runs of batch 2 are tools/chtc/batch2.sub.
# Submit from the repository root in /home, with the batch-1 run directories present:
#   condor_submit tools/chtc/batch2_resume.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

# ---- resumes of batch-1 runs (50k -> 100k) --------------------------------------------------------
arguments                 = $(RUN) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=resume_$(ARM).json"
transfer_input_files      = src, configs/resume_$(ARM).json, data/cache/PE.npz, run_$(RUN)
transfer_checkpoint_files = run_$(RUN)
transfer_output_files     = run_$(RUN)
log                       = logs/$(RUN)_resume_c$(Cluster).log
output                    = logs/$(RUN)_resume_c$(Cluster).out
error                     = logs/$(RUN)_resume_c$(Cluster).err

queue ARM, RUN, SEED from (
  m128, m128_c7675778_seed0, 0
  m128, m128_c7675778_seed1, 1
  m128, m128_c7675778_seed2, 2
  wd01, wd01_c7675778_seed0, 0
  wd01, wd01_c7675778_seed1, 1
  wd01, wd01_c7675778_seed2, 2
)
