# Batch 5, new runs: 2 arms x 3 seeds x 50k = 6 jobs. Each keeps full checkpoints at 20k-50k (full_XXXXXX.pt).
#   positions_scaled  critic_input "positions_scaled", critic_position_scale 2.9873; lambda 10, M 64, sigma units,
#                     otherwise pe_paper.json. The critic sees cumsum(window) / 2.9873 over all 2M = 128 steps.
#                     SCALE: 2.9873 = RMS(positions) / RMS(increments), one scalar pooled over all 128 steps and
#                     3 axes of the 60 offset-0 PE training windows (first 128 steps of each trajectory) of
#                     data/cache/PE.npz (md5 facf5c56dcd39fbae858acabc79dea61); by that formula 2.98735. The run
#                     also writes the ratio of its own windows to dataset.json and refuses to start if the two
#                     differ by more than 1 %.
#                     PREDICTION: share78 and the ballistic fraction fall; DC falls if the drift signal reaches G_z.
#   offsets64         window_offset_max_steps 500 at M = 64, increments critic: training windows start at a fresh
#                     offset in [0, 500] steps; region 2*64 + 500 = 628 steps = 6.28 ns of each trajectory (paper:
#                     1.28 ns), so a modification. sigma from the offset-0 windows.
#                     PREDICTION: var/MD toward 0.8; DC and share78 unchanged.
# The positions resumes (50k -> 100k) are tools/chtc/batch5_resume.sub.
# Submit from the repository root in /home:  condor_submit tools/chtc/batch5.sub

universe                  = container
container_image           = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable                = tools/chtc/run_train.sh
should_transfer_files     = YES
when_to_transfer_output   = ON_EXIT
checkpoint_exit_code      = 85

request_gpus              = 1
# The container's PyTorch (2.5.1, CUDA 12.4) has GPU code for compute capability 5.0-9.0 only;
# newer GPUs fail at the first CUDA call ('no kernel image is available'). 9.0 = H100, 8.9 = L40.
gpus_minimum_capability   = 7.0
gpus_maximum_capability   = 9.0
# gpu2008: its GPU fails every job at the first CUDA call (busy or unavailable), Nov 2026
requirements              = (Machine != "gpu2008.chtc.wisc.edu")
+WantGPULab               = true
+GPUJobLength             = "short"
request_cpus              = 2
request_memory            = 4GB
request_disk              = 5GB

# ---- new runs -------------------------------------------------------------------------------------
arguments                 = $(ARM)_c$(Cluster)_seed$(SEED) $(SEED)
environment               = "MAX_HOURS=11 CONFIG=batch5_$(ARM).json"
transfer_input_files      = src, configs/batch5_$(ARM).json, data/cache/PE.npz
transfer_checkpoint_files = run_$(ARM)_c$(Cluster)_seed$(SEED)
transfer_output_files     = run_$(ARM)_c$(Cluster)_seed$(SEED)
log                       = logs/$(ARM)_c$(Cluster)_seed$(SEED).log
output                    = logs/$(ARM)_c$(Cluster)_seed$(SEED).out
error                     = logs/$(ARM)_c$(Cluster)_seed$(SEED).err

queue ARM, SEED from (
  positions_scaled, 0
  positions_scaled, 1
  positions_scaled, 2
  offsets64, 0
  offsets64, 1
  offsets64, 2
)
